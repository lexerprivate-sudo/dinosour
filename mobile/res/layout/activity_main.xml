<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/app_bg">

  <WebView
    android:id="@+id/web"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <ProgressBar
    android:id="@+id/pageProgress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:layout_gravity="top"
    android:max="100"
    android:progress="0"
    android:progressTint="@color/brand_red"
    android:progressBackgroundTint="@android:color/transparent"
    android:visibility="gone" />

  <FrameLayout
    android:id="@+id/setup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="▶"
          android:textColor="@color/brand_red"
          android:textSize="22sp" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="@string/app_name"
          android:textColor="@color/app_text"
          android:textSize="34sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="26dp"
          android:text="@string/connect_title"
          android:textColor="@color/app_text"
          android:textSize="18sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/setupMsg"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:gravity="center"
          android:lineSpacingExtra="3dp"
          android:text="@string/connect_body"
          android:textColor="@color/app_text_dim"
          android:textSize="14sp" />

        <EditText
          android:id="@+id/urlInput"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginTop="22dp"
          android:autofillHints="url"
          android:backgroundTint="@color/brand_red"
          android:hint="http://192.168.1.10:3000"
          android:imeOptions="actionGo"
          android:inputType="textUri"
          android:maxLines="1"
          android:paddingStart="4dp"
          android:paddingEnd="4dp"
          android:singleLine="true"
          android:textColor="@color/app_text"
          android:textColorHint="#666666"
          android:textSize="15sp" />

        <Button
          android:id="@+id/connectBtn"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginTop="14dp"
          android:backgroundTint="@color/brand_red"
          android:text="@string/connect"
          android:textAllCaps="false"
          android:textColor="#FFFFFF"
          android:textSize="15sp" />

        <Button
          android:id="@+id/findBtn"
          style="?android:attr/borderlessButtonStyle"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginTop="2dp"
          android:text="@string/find"
          android:textAllCaps="false"
          android:textColor="#3EA6FF"
          android:textSize="14sp" />

        <Button
          android:id="@+id/cloudBtn"
          style="?android:attr/borderlessButtonStyle"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginTop="2dp"
          android:text="@string/cloud"
          android:textAllCaps="false"
          android:textColor="@color/app_text"
          android:textSize="15sp" />

        <ProgressBar
          android:id="@+id/findProgress"
          style="?android:attr/progressBarStyleSmall"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:indeterminateTint="@color/brand_red"
          android:visibility="gone" />

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:gravity="center"
          android:lineSpacingExtra="3dp"
          android:text="@string/connect_hint"
          android:textColor="#717171"
          android:textSize="12sp" />
      </LinearLayout>
    </ScrollView>
  </FrameLayout>
</FrameLayout>
